{
  "name": "folio-civico",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:browser": "playwright test --config=playwright.config.ts",
    "test:performance": "playwright test --config=playwright.performance.config.ts",
    "demo:local": "pnpm --dir apps/web exec node demo-local.mjs",
    "test:demo": "playwright test --config=playwright.demo.config.ts",
    "test:inspector": "python3 -m unittest discover -s apps/inspector/tests",
    "test:local-ci": "python3 -m unittest discover -s tests -p test_local_ci.py",
    "check:frontend-budget": "node scripts/check-frontend-budget.mjs",
    "test:inspector:real": "python3 apps/inspector/smoke_real_engines.py",
    "test:inspector:docker": "bash apps/inspector/validate_real_engines.sh",
    "audit:inspector:image": "bash apps/inspector/audit_image.sh",
    "typecheck": "tsc --noEmit",
    "build": "pnpm --filter @folio/web build && pnpm --filter @folio/api build && pnpm --filter @folio/mcp build && pnpm --filter @folio/processor build && pnpm --filter @folio/inspector-gateway build",
    "check": "pnpm test && pnpm test:inspector && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vitest-plugin": "1.8.4",
    "@cloudflare/workers-types": "^5.20261118.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "wrangler": "^4.0.0"
  }
}
