{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "folio-civico-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "DOCUMENT_UPLOADS_ENABLED": "false"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "folio-civico-preview",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "../../migrations"
  }],
  "r2_buckets": [{
    "binding": "DOCUMENTS",
    "bucket_name": "folio-civico-quarantine-preview"
  }],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  }
}
