{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "folio-civico-processor",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "folio-civico-preview",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "../../migrations"
  }],
  "r2_buckets": [{
    "binding": "DOCUMENTS",
    "bucket_name": "folio-civico-quarantine-preview"
  }],
  "queues": {
    "consumers": [{
      "queue": "folio-civico-pdf-pending",
      "dead_letter_queue": "folio-civico-pdf-dead-letter",
      "max_batch_size": 5,
      "max_retries": 3,
      "retry_delay": 60
    }]
  }
}
