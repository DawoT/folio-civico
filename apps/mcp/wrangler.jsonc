{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "folio-civico-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "folio-civico-preview",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "../../migrations"
  }]
}
