# R1.36: disposable LOCAL research container, never an operative inspector OCI.
# Debian packages are verified by APT's signed repository metadata; exact
# package versions and executable SHA-256 are measured during the smoke test.
# This build is NOT source-to-ELF reproducibility, not a CVE or release claim.
FROM debian:trixie-slim
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       poppler-utils qpdf ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8
USER 65534:65534
