# R1.42 — NON-DEPLOYABLE research: merged filesystem only, no inherited layers.
# The operator must pass the exact local repo@sha256 digest of the R1.41 image.
# Without the argument the source is scratch, so COPY / fails closed.
ARG POPPLER_FLAT_SOURCE=scratch
FROM ${POPPLER_FLAT_SOURCE} AS source

FROM scratch
COPY --from=source / /

# Reproduce the R1.41 image runtime configuration except the public Python
# build-time GPG key fingerprint, which is unnecessary in runtime metadata.
ENV PATH=/opt/folio-poppler/bin:/opt/folio-ocr/bin:/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LANG=C.UTF-8 \
    PYTHON_VERSION=3.12.16 \
    PYTHON_SHA256=b5796915dc45ff745cfb4e990a7e7c93d6f546328a102ce31448d69ebc37575c \
    TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CLAMAV_DB_DIR=/opt/clamdb \
    FOLIO_INSPECTOR_BIND=0.0.0.0
WORKDIR /srv/folio-inspector
USER 65534:65534
EXPOSE 8789
CMD ["python3", "-I", "/srv/folio-inspector/inspector.py"]
