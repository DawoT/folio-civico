# NON-DEPLOYABLE R1.23: flatten the exact runtime filesystem into one OCI layer.
# Only orphaned pinentry/ncursesw package files are removed; security gate still blocks.
FROM folio-civico-inspector:headless-pruned-experiment AS pruner
USER root
ARG ORPHAN_PACKAGES="pinentry-curses libncursesw6"
RUN set -eux; \
  apt-get -s purge $ORPHAN_PACKAGES > /tmp/folio-terminal-prune-plan; \
  python3 -c 'import pathlib; p=pathlib.Path("/tmp/folio-terminal-prune-plan").read_text(); expected={"pinentry-curses","libncursesw6"}; removed={line.split()[1] for line in p.splitlines() if line.startswith("Purg ")}; assert removed==expected and len(removed)==2 and "WARNING:" not in p, (expected,removed)'; \
  apt-get purge -y --no-install-recommends $ORPHAN_PACKAGES; \
  rm /tmp/folio-terminal-prune-plan; \
  for package in pinentry-curses libncursesw6; do \
    status="$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null)" || status=""; \
    test "$status" != "install ok installed"; \
  done; \
  for package in ncurses-bin libtinfo6 libtiff6 libleptonica6 qpdf libexpat1 util-linux; do \
    test "$(dpkg-query -W -f='${Status}' "$package")" = "install ok installed"; \
  done; \
  test -x /opt/folio-poppler/bin/pdfinfo; \
  test -x /opt/folio-poppler/bin/pdftotext; \
  test -x /opt/folio-poppler/bin/pdftoppm; \
  test -x /opt/folio-poppler/bin/pdfdetach; \
  test -x /opt/folio-poppler/bin/pdfattach; \
  test -x /opt/folio-ocr/bin/tesseract; \
  test -s /usr/share/tesseract-ocr/5/tessdata/eng.traineddata; \
  test -s /usr/share/tesseract-ocr/5/tessdata/spa.traineddata; \
  test -r /etc/fonts/fonts.conf; \
  for tool in pdfinfo pdftotext pdftoppm pdfdetach pdfattach; do \
    ! ldd "/opt/folio-poppler/bin/$tool" | grep -F 'not found'; \
  done; \
  ! ldd /opt/folio-ocr/lib/libtesseract.so.5.5.4 | grep -F 'not found'; \
  command -v clamscan; \
  clamscan --version | grep -F 'ClamAV 1.5.5'

# This copies the final merged filesystem only. Earlier source-builder,
# GnuPG, X11 and deleted-file OCI layers are NOT inherited. Not a clean
# source build or standalone release: package CVEs are still present.
FROM scratch
COPY --from=pruner / /

# Reconstruct the relevant Docker runtime metadata exactly. Checked against
# the original image's inspect record by the differential gate.
ENV PATH=/opt/folio-poppler/bin:/opt/folio-ocr/bin:/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LANG=C.UTF-8 \
    PYTHON_VERSION=3.12.16 \
    PYTHON_SHA256=b5796915dc45ff745cfb4e990a7e7c93d6f546328a102ce31448d69ebc37575c \
    TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CLAMAV_DB_DIR=/opt/clamdb \
    FOLIO_INSPECTOR_BIND=0.0.0.0
WORKDIR /srv/folio-inspector
USER 65534:65534
EXPOSE 8789
CMD ["python3", "-I", "/srv/folio-inspector/inspector.py"]
