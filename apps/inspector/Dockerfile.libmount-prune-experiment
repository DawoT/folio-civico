# R1.29 NON-DEPLOYABLE: nine unused libmount clients and the DSO are deleted.
# Trivy CVEs remain visible; this is not a util-linux source fix or VEX.
FROM folio-civico-inspector:privileged-loader-removed-experiment AS hardener
USER root
COPY libmount_prune_surface.py /tmp/libmount_prune_surface.py
RUN set -eux; \
  python3 -I /tmp/libmount_prune_surface.py --remove; \
  python3 -I /tmp/libmount_prune_surface.py; \
  rm /tmp/libmount_prune_surface.py; \
  test ! -e /usr/lib/x86_64-linux-gnu/libmount.so.1; \
  test ! -e /usr/lib/x86_64-linux-gnu/libmount.so.1.1.0; \
  test ! -e /usr/bin/findmnt; \
  test ! -e /usr/bin/lsblk; \
  test ! -e /usr/sbin/swapon; \
  test -e /usr/lib/x86_64-linux-gnu/libuuid.so.1; \
  test -e /usr/lib/x86_64-linux-gnu/libblkid.so.1; \
  test -x /usr/local/bin/clamscan; \
  test -x /opt/folio-poppler/bin/pdfinfo; \
  test -x /opt/folio-ocr/bin/tesseract; \
  clamscan --version | grep -F 'ClamAV 1.5.5'

# Flatten to remove old OCI layers containing deleted libmount ELF bytes.
FROM scratch
COPY --from=hardener / /
ENV PATH=/opt/folio-poppler/bin:/opt/folio-ocr/bin:/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LANG=C.UTF-8 \
    PYTHON_VERSION=3.12.16 \
    PYTHON_SHA256=b5796915dc45ff745cfb4e990a7e7c93d6f546328a102ce31448d69ebc37575c \
    TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CLAMAV_DB_DIR=/opt/clamdb \
    FOLIO_INSPECTOR_BIND=0.0.0.0
WORKDIR /srv/folio-inspector
USER 65534:65534
EXPOSE 8789
CMD ["python3", "-I", "/srv/folio-inspector/inspector.py"]
