# R1.24 NON-DEPLOYABLE: remove executable privilege entrypoints, not CVEs.
# All Debian package metadata and vulnerabilities remain observable to Trivy.
FROM folio-civico-inspector:flat-runtime-experiment AS hardener
USER root
COPY privilege_surface.py /tmp/privilege_surface.py
RUN set -eux; \
  python3 -I /tmp/privilege_surface.py --apply; \
  rm /tmp/privilege_surface.py; \
  test -x /opt/folio-poppler/bin/pdfinfo; \
  test -x /opt/folio-poppler/bin/pdftotext; \
  test -x /opt/folio-poppler/bin/pdftoppm; \
  test -x /opt/folio-poppler/bin/pdfdetach; \
  test -x /opt/folio-poppler/bin/pdfattach; \
  test -x /opt/folio-ocr/bin/tesseract; \
  test -s /usr/share/tesseract-ocr/5/tessdata/spa.traineddata; \
  test -s /usr/share/tesseract-ocr/5/tessdata/eng.traineddata; \
  test "$(dpkg-query -W -f='${Status}' util-linux)" = "install ok installed"; \
  test "$(dpkg-query -W -f='${Status}' mount)" = "install ok installed"; \
  test "$(dpkg-query -W -f='${Status}' libmount1)" = "install ok installed"; \
  ! ldd /opt/folio-poppler/lib/libpoppler.so.147 | grep -F 'not found'; \
  ! ldd /opt/folio-ocr/lib/libtesseract.so.5.5.4 | grep -F 'not found'; \
  clamscan --version | grep -F 'ClamAV 1.5.5'

# Flatten all file changes into a NEW filesystem, with no historical SUID
# executable layer inherited in the runtime artifact. BuildKit may add the
# known empty WORKDIR metadata layer; strict comparison checks this.
FROM scratch
COPY --from=hardener / /
ENV PATH=/opt/folio-poppler/bin:/opt/folio-ocr/bin:/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LANG=C.UTF-8 \
    PYTHON_VERSION=3.12.16 \
    PYTHON_SHA256=b5796915dc45ff745cfb4e990a7e7c93d6f546328a102ce31448d69ebc37575c \
    TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CLAMAV_DB_DIR=/opt/clamdb \
    FOLIO_INSPECTOR_BIND=0.0.0.0
WORKDIR /srv/folio-inspector
USER 65534:65534
EXPOSE 8789
CMD ["python3", "-I", "/srv/folio-inspector/inspector.py"]
