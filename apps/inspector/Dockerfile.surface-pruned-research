# R1.46: research-only removal of unused X11/terminal/mount surface.
# Not a release image; pin the locally verified R1.45 source by immutable ID.
ARG RESEARCH_BASE=scratch
FROM ${RESEARCH_BASE} AS pruner
USER root

RUN set -eu; \
    apt-get -s purge mount libx11-6 libx11-data libxrender1 libncursesw6 \
      > /tmp/folio-surface-prune-plan; \
    python3 -c 'from pathlib import Path; data=Path("/tmp/folio-surface-prune-plan").read_text(); removed=[row.split()[1] for row in data.splitlines() if row.startswith(("Purg ", "Remv "))]; expected={"libcairo2","pinentry-curses","libncursesw6","libxext6","libxrender1","libx11-6","libx11-data","mount"}; assert len(removed)==len(expected) and set(removed)==expected and "WARNING:" not in data, (removed,expected)'; \
    apt-get purge -y --no-install-recommends \
      mount libx11-6 libx11-data libxrender1 libncursesw6; \
    rm -f /tmp/folio-surface-prune-plan; \
    for package in libcairo2 pinentry-curses libncursesw6 libxext6 libxrender1 libx11-6 libx11-data mount; do \
      installed="$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null)" || installed=''; \
      test "$installed" != "install ok installed"; \
    done; \
    for package in util-linux bsdutils login libmount1 libblkid1 libuuid1 libsqlite3-0 libexpat1 libfontconfig1 libtiff6 libopenjp2-7 libleptonica6 qpdf libqpdf30 libtinfo6 ncurses-bin ncurses-base; do \
      test "$(dpkg-query -W -f='${Status}' "$package")" = "install ok installed"; \
    done; \
    for binary in pdfinfo pdftotext pdftoppm pdfdetach pdfattach; do \
      test -x "/opt/folio-poppler/bin/$binary"; \
      ! ldd "/opt/folio-poppler/bin/$binary" | grep -E 'not found|libX11|libXrender|libcairo|libncurses|libmount'; \
    done; \
    test -x /opt/folio-ocr/bin/tesseract; \
    ! ldd /opt/folio-ocr/bin/tesseract | grep -E 'not found|libX11|libXrender|libcairo|libncurses|libmount'; \
    ! ldd /opt/folio-ocr/lib/libtesseract.so.5.5.4 | grep -E 'not found|libX11|libXrender|libcairo|libncurses|libmount'; \
    command -v qpdf; \
    test -r /etc/fonts/fonts.conf; \
    test -s /usr/share/tesseract-ocr/5/tessdata/eng.traineddata; \
    test -s /usr/share/tesseract-ocr/5/tessdata/spa.traineddata; \
    clamscan --version | grep -F 'ClamAV 1.5.5'

# Eliminate historical OCI layers that could still contain removed bytes.
FROM scratch
COPY --from=pruner / /
ENV PATH=/opt/folio-poppler/bin:/opt/folio-ocr/bin:/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LANG=C.UTF-8 \
    PYTHON_VERSION=3.12.16 \
    PYTHON_SHA256=b5796915dc45ff745cfb4e990a7e7c93d6f546328a102ce31448d69ebc37575c \
    TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CLAMAV_DB_DIR=/opt/clamdb \
    FOLIO_INSPECTOR_BIND=0.0.0.0
WORKDIR /srv/folio-inspector
USER 65534:65534
EXPOSE 8789
CMD ["python3", "-I", "/srv/folio-inspector/inspector.py"]
