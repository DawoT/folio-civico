# G2 / R1.56 — local code-parity research, never an approved runtime image.
# Sources and base ID are verified independently by the build and scan wrappers.
ARG RESEARCH_BASE=folio-civico-inspector:combined-clamav-cli-r155-local
FROM ${RESEARCH_BASE} AS code_refresh
USER root
# Exact production Dockerfile Python payload, not just inspector.py.
COPY --chown=65534:65534 inspector.py qpdf_paint_triage_r154.py qpdf_scoped_gate_r155.py fixtures.py preflight.py smoke_real_engines.py smoke_http_real.py /srv/folio-inspector/
RUN set -eu; \
    python3 -B -I -c 'import ast,pathlib; folder=pathlib.Path("/srv/folio-inspector"); names=("inspector.py","qpdf_paint_triage_r154.py","qpdf_scoped_gate_r155.py","fixtures.py","preflight.py","smoke_real_engines.py","smoke_http_real.py"); [ast.parse((folder/n).read_bytes(),filename=n) for n in names]'; \
    test -x /usr/local/bin/clamscan; \
    test ! -e /usr/local/bin/freshclam; \
    test ! -e /usr/local/sbin/clamd; \
    test ! -e /usr/bin/nsenter; \
    test ! -e /usr/bin/unshare; \
    test -x /opt/folio-poppler/bin/pdfinfo; \
    test -x /opt/folio-ocr/bin/tesseract; \
    printf '%s  %s\n' '834cf9412cec3e83fee99c0480847e50d0d32952bd1f768dc08033682bfc81ea' '/srv/folio-inspector/__pycache__/inspector.cpython-312.pyc' | sha256sum --check -; \
    rm /srv/folio-inspector/__pycache__/inspector.cpython-312.pyc; \
    rmdir /srv/folio-inspector/__pycache__; \
    test ! -e /srv/folio-inspector/__pycache__

# Old native CLI binaries must not remain extractable from inherited layers.
FROM scratch
COPY --from=code_refresh / /
ENV PATH=/opt/folio-poppler/bin:/opt/folio-ocr/bin:/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LANG=C.UTF-8 \
    PYTHON_VERSION=3.12.16 \
    PYTHON_SHA256=b5796915dc45ff745cfb4e990a7e7c93d6f546328a102ce31448d69ebc37575c \
    TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CLAMAV_DB_DIR=/opt/clamdb \
    FOLIO_INSPECTOR_BIND=0.0.0.0
WORKDIR /srv/folio-inspector
USER 65534:65534
EXPOSE 8789
CMD ["python3", "-I", "/srv/folio-inspector/inspector.py"]
