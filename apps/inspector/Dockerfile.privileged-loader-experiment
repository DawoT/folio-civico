# R1.28 NON-DEPLOYABLE: remove the 14 R1.24 chmod-only privileged ELFs.
# chmod 0644 alone was bypassable by the system dynamic ELF loader.
# All Debian package metadata and Trivy findings remain visible.
FROM folio-civico-inspector:clamav-cli-limited-experiment AS hardener
USER root
COPY privileged_loader_surface.py /tmp/privileged_loader_surface.py
RUN set -eux; \
  python3 -I /tmp/privileged_loader_surface.py --remove; \
  python3 -I /tmp/privileged_loader_surface.py; \
  rm /tmp/privileged_loader_surface.py; \
  test ! -e /usr/bin/mount; \
  test ! -e /usr/bin/nsenter; \
  test ! -e /usr/bin/unshare; \
  test ! -e /usr/bin/su; \
  test ! -e /usr/bin/passwd; \
  test -e /lib/x86_64-linux-gnu/libmount.so.1; \
  test -e /lib/x86_64-linux-gnu/libuuid.so.1; \
  test -x /usr/local/bin/clamscan; \
  test -x /opt/folio-poppler/bin/pdfinfo; \
  test -x /opt/folio-ocr/bin/tesseract; \
  clamscan --version | grep -F 'ClamAV 1.5.5'

# The new runtime must not inherit historical filesystem layers containing
# the removed privileged program bytes. Package identities are preserved.
FROM scratch
COPY --from=hardener / /
ENV PATH=/opt/folio-poppler/bin:/opt/folio-ocr/bin:/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LANG=C.UTF-8 \
    PYTHON_VERSION=3.12.16 \
    PYTHON_SHA256=b5796915dc45ff745cfb4e990a7e7c93d6f546328a102ce31448d69ebc37575c \
    TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CLAMAV_DB_DIR=/opt/clamdb \
    FOLIO_INSPECTOR_BIND=0.0.0.0
WORKDIR /srv/folio-inspector
USER 65534:65534
EXPOSE 8789
CMD ["python3", "-I", "/srv/folio-inspector/inspector.py"]
