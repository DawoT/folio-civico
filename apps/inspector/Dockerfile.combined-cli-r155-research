# R1.55 LOCAL RESEARCH ONLY. Never publish, deploy, waive CVEs or alter vendor binaries.
# Source image is checked by exact immutable Docker ID before and after the build.
ARG RESEARCH_BASE=folio-civico-inspector:privileged-cli-pruned-research-r148
FROM ${RESEARCH_BASE} AS hardener
USER root
COPY clamav_cli_surface.py /tmp/r155_clamav_cli_surface.py
RUN set -eu; \
    python3 -B -I /tmp/r155_clamav_cli_surface.py --apply; \
    python3 -B -I /tmp/r155_clamav_cli_surface.py; \
    rm /tmp/r155_clamav_cli_surface.py; \
    test -x /usr/local/bin/clamscan; \
    test ! -e /usr/local/bin/freshclam; \
    test ! -e /usr/local/sbin/clamd; \
    test ! -e /usr/bin/nsenter; \
    test ! -e /usr/bin/unshare; \
    test -x /opt/folio-poppler/bin/pdfinfo; \
    test -x /opt/folio-ocr/bin/tesseract; \
    /usr/local/bin/clamscan --version

# Flatten: no inherited layer from which a deleted native executable can be extracted.
FROM scratch
COPY --from=hardener / /
ENV PATH=/opt/folio-poppler/bin:/opt/folio-ocr/bin:/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LANG=C.UTF-8 \
    PYTHON_VERSION=3.12.16 \
    PYTHON_SHA256=b5796915dc45ff745cfb4e990a7e7c93d6f546328a102ce31448d69ebc37575c \
    TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CLAMAV_DB_DIR=/opt/clamdb \
    FOLIO_INSPECTOR_BIND=0.0.0.0
WORKDIR /srv/folio-inspector
USER 65534:65534
EXPOSE 8789
CMD ["python3", "-I", "/srv/folio-inspector/inspector.py"]
